# VCS / editor / tooling
.git
.gitignore
.gitattributes
.editorconfig
.vscode
.idea
.fleet
.nova
.zed
.claude

# Dependencies (installed fresh inside the image)
/vendor
/node_modules
/print-service

# Env files — real secrets come from the platform at runtime, never baked in
.env
.env.*
!.env.example

# Build output (regenerated by `npm run build` during the image build)
/public/build
/public/hot
/public/storage

# Local/dev artifacts
.phpunit.result.cache
.phpunit.cache
storage/*.key
storage/pail
storage/logs/*.log
/tests

# Unrelated tooling caches
/graphify-out
